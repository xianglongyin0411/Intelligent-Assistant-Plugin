{
  "name": "intelligent-assistant-plugin",
  "displayName": "Intelligent Assistant",
  "description": "AI-powered intelligent assistant for VS Code with DeepSeek integration",
  "version": "1.0.0",
  "publisher": "midea",
  "engines": {
    "vscode": "^1.96.0"
  },
  "categories": [
    "Other",
    "Machine Learning"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "assistant.openPanel",
        "title": "Open AI Assistant",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "assistant.sendMessage",
        "title": "Send Message"
      },
      {
        "command": "assistant.clearChat",
        "title": "Clear Chat History",
        "icon": "$(trash)"
      },
      {
        "command": "assistant.configure",
        "title": "Configure AI Model",
        "icon": "$(settings-gear)"
      },
      {
        "command": "assistant.manageModels",
        "title": "Manage AI Models",
        "icon": "$(settings-gear)"
      }
    ],
    "views": {
      "explorer": [
        {
          "id": "assistantPanel",
          "name": "AI Assistant",
          "type": "webview"
        }
      ]
    },
    "configuration": {
      "title": "Intelligent Assistant",
      "properties": {
        "assistant.apiKey": {
          "type": "string",
          "default": "",
          "description": "DeepSeek API Key"
        },
        "assistant.model": {
          "type": "string",
          "default": "deepseek-chat",
          "description": "Model to use"
        },
        "assistant.baseUrl": {
          "type": "string",
          "default": "https://api.deepseek.com/v1",
          "description": "API base URL"
        },
        "assistant.temperature": {
          "type": "number",
          "default": 0.7,
          "minimum": 0,
          "maximum": 2,
          "description": "Temperature for model responses"
        },
        "assistant.maxTokens": {
          "type": "number",
          "default": 2048,
          "description": "Maximum tokens in response"
        },
        "assistant.models": {
          "type": "array",
          "default": [],
          "description": "Array of AI model configurations"
        },
        "assistant.currentModelId": {
          "type": "string",
          "default": "",
          "description": "Currently selected model ID"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile && npm run bundle",
    "compile": "tsc -p ./",
    "bundle": "webpack --mode production",
    "bundle:dev": "webpack --mode development",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src --ext ts"
  },
  "devDependencies": {
    "@types/dompurify": "^3.0.5",
    "@types/marked": "^5.0.2",
    "@types/node": "^22.10.2",
    "@types/react": "^19.2.8",
    "@types/react-dom": "^18.3.7",
    "@types/vscode": "^1.96.0",
    "@typescript-eslint/eslint-plugin": "^8.19.1",
    "@typescript-eslint/parser": "^8.19.1",
    "copy-webpack-plugin": "^13.0.1",
    "css-loader": "^7.1.2",
    "eslint": "^9.18.0",
    "style-loader": "^4.0.0",
    "ts-loader": "^9.5.4",
    "typescript": "^5.7.2",
    "webpack": "^5.104.1",
    "webpack-cli": "^6.0.1"
  },
  "dependencies": {
    "dompurify": "^3.3.1",
    "highlight.js": "^11.11.1",
    "marked": "^17.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  }
}
